FROM python:3.12-slim-bookworm

WORKDIR /app
COPY requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt

COPY service.py portal.py runtime_config.py greybox.py task_submission.py task_reuse.py model_calls.py call_details.py model_failover.py ./
COPY static ./static

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 STRIX_DATA_DIR=/srv/strix-data \
    WEB_CONFIG_REQUIRED=true ENABLE_SCANS=false
EXPOSE 8080
CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
